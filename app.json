{
  "expo": {
    "name": "CG Trivia",
    "slug": "cultura-general",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "culturalgeneral",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a0a0a",
    "primaryColor": "#E07A3E",
    "locales": {
      "es": "./locales/native/es.json",
      "en": "./locales/native/en.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.polinss3.culturalgeneral",
      "buildNumber": "92",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "The app does not use the camera.",
        "NSUserNotificationsUsageDescription": "Get a daily reminder to answer the question of the day and keep your streak.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.polinss3.culturalgeneral",
      "versionCode": 6,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "./plugins/withFmtConstevalFix",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a",
          "imageWidth": 200
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#e8a030",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "pablo-brasero"
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c320cb92-68f2-4474-9414-750921c2ac79"
      }
    },
    "owner": "pablobrasero"
  }
}
