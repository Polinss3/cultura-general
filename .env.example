EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Fail-closed: solo se aceptan off, test o live. Ausente/inválido equivale a off.
EXPO_PUBLIC_ADS_MODE=off

# ─── In-House Ads ────────────────────────────────────────────────────────────
# Publicidad propia: el servidor es nuestro y solo promociona apps y webs
# propias. Los UUID de aplicación y de ubicación son identificadores PÚBLICOS,
# no secretos: el servidor decide la disponibilidad y firma las autorizaciones
# de evento, redirección y recompensa. No hay ninguna clave que guardar aquí.
#
# Los valores reales del panel están en eas.json (perfiles development y
# preview). Cópialos a .env.local para probar con `expo run:ios`.
EXPO_PUBLIC_INHOUSE_ADS_URL=https://inhouseads.pablobrasero.com
EXPO_PUBLIC_INHOUSE_APP_ID=

# Una ubicación por pausa natural y por acción voluntaria.
EXPO_PUBLIC_INHOUSE_PLACEMENT_DAILY_RESULT=
EXPO_PUBLIC_INHOUSE_PLACEMENT_SPEED_RESULT=
EXPO_PUBLIC_INHOUSE_PLACEMENT_LADDER_RESULT=
EXPO_PUBLIC_INHOUSE_PLACEMENT_FLAGS_RESULT=
EXPO_PUBLIC_INHOUSE_PLACEMENT_YEARS_RESULT=
EXPO_PUBLIC_INHOUSE_PLACEMENT_SHOP_COINS=
EXPO_PUBLIC_INHOUSE_PLACEMENT_LADDER_REVIVE=
EXPO_PUBLIC_INHOUSE_PLACEMENT_BANNER=

# Recompensados: la Tienda (+monedas) y revivir en Ascenso.
EXPO_PUBLIC_REWARDED_ADS=false

# Banner al pie de las pantallas de juego (Contrarreloj, Ascenso, Mundo, Años,
# Aprender, Aventura). Apagado por decisión de producto, no por límite técnico:
# ver docs/ads-inhouse.md.
EXPO_PUBLIC_BANNER_ADS=false

# RevenueCat (CG PRO). Sin clave, la app funciona entera en modo gratuito y el
# paywall avisa de que la suscripción llegará en la próxima actualización.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AppsFlyer: sin dev key el SDK no se inicializa nunca. Solo arranca tras
# consentir la medición, y mide campañas de captación, no los anuncios propios.
EXPO_PUBLIC_APPSFLYER_DEV_KEY=

# Sentry: el DSN está hardcoded en app/_layout.tsx (es público por diseño).
# Las siguientes son SOLO de build (NO EXPO_PUBLIC_) y se usan para subir
# los source maps a Sentry. Defínelas en EAS con `eas env:create`:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=pablo-brasero
# SENTRY_PROJECT=react-native
