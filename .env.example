EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Fail-closed: solo se aceptan off, test o live. Ausente/inválido equivale a off.
EXPO_PUBLIC_ADS_MODE=off

# Mantén los valores de producción en EAS Environment / un gestor de secretos.
EXPO_PUBLIC_APPLOVIN_SDK_KEY=
EXPO_PUBLIC_APPLOVIN_IOS_INTERSTITIAL=
EXPO_PUBLIC_APPLOVIN_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_APPLOVIN_IOS_BANNER=
EXPO_PUBLIC_APPLOVIN_ANDROID_BANNER=
EXPO_PUBLIC_APPLOVIN_IOS_REWARDED=
EXPO_PUBLIC_APPLOVIN_ANDROID_REWARDED=

# IDFA/GAID de QA separados por comas; se registran antes de initialize().
EXPO_PUBLIC_APPLOVIN_TEST_DEVICE_IDS=
# Banner al pie de las pantallas de juego (Contrarreloj, Ascenso, Mundo,
# Aprender). Requiere además las unidades de banner de arriba.
EXPO_PUBLIC_BANNER_ADS=false
EXPO_PUBLIC_REWARDED_HINTS=false

# AppsFlyer: sin dev key el SDK no se inicializa nunca. Solo arranca tras una
# elección publicitaria personalizada.
EXPO_PUBLIC_APPSFLYER_DEV_KEY=

# Contenido literal proporcionado por MAX > Account > General > app-ads.txt.
# No inventar seller IDs ni DIRECT/RESELLER. El endpoint queda vacío hasta tenerlo.
APPLOVIN_APP_ADS_TXT=

# Sentry: el DSN está hardcoded en app/_layout.tsx (es público por diseño).
# Las siguientes son SOLO de build (NO EXPO_PUBLIC_) y se usan para subir
# los source maps a Sentry. Defínelas en EAS con `eas env:create`:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=pablo-brasero
# SENTRY_PROJECT=react-native
